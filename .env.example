# =====================================================
# Firebase SDK Cliente (PUBLIC - seguro para el navegador)
# Obtenidas desde: Firebase Console > matchhome-crm-46de4 > Configuracion > SDK config
# =====================================================
PUBLIC_FIREBASE_API_KEY=AIzaSy...
PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# =====================================================
# EasyBroker
# =====================================================
EASYBROKER_API_KEY=tu_api_key_aqui
# Para multi-tenant, agrega keys por cliente:
# EASYBROKER_API_KEY_ALPHA=key_del_cliente_alpha

# =====================================================
# Firebase Admin SDK (PRIVADO - solo servidor)
# Obtenidas desde: Firebase Console > Configuracion del proyecto > Cuentas de servicio
# > Generar nueva clave privada (descarga el JSON y copia los campos aqui)
# =====================================================
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@tu-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY_ID=tu_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_ID=tu_client_id
